# 复制为 .env.local 后填写；.env.local 已在 .gitignore 里，不会被提交
# 复制：Copy-Item .env.example .env.local

# 百度地图「浏览器端」AK：https://lbsyun.baidu.com/ → 控制台 → 应用管理 → 创建应用（应用类型选「浏览器端」）
# Referer 白名单填：http://127.0.0.1:5173/*  （部署后再加上线上域名）
# 不填也能跑，只是地图区域会显示占位提示
VITE_BAIDU_AK=

# 1（默认）= 用 src/mocks/*.json 的本地假数据：演示地图、环线和固定双起点；完整功能需要真实后端
# 0 = 请求 /api/*，由 vite 代理到 127.0.0.1:8000（需先起后端）
VITE_USE_MOCK=1
