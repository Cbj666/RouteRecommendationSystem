# 密钥模板：复制为 .env 再填值。.env 已被 .gitignore 排除，不会入库。
#   Copy-Item .env.example .env
#
# 读取规则：环境变量 > .env > .env.txt（实现见 backend/app/secrets.py）
# 自检：.\.venv\Scripts\python.exe -m app.secrets check
#
# 注意：本文件里的变量一律不带 VITE_ 前缀。带 VITE_ 的变量会被 Vite 打包进
# 浏览器产物，等于公开密钥。前端需要的只是后端地址，见 frontend/app/.env.example。

# ---- 高德（必填；场馆/公厕抓取、/api/places/search 在线地点搜索）----
# 申请：https://lbs.amap.com/ → 控制台 → 应用管理 → 添加 Key → 服务平台选「Web服务」
# 三个名字等价，任一即可，优先级 AMAP_WEB_KEY > GAODE_KEY > AMAP_KEY
AMAP_WEB_KEY=
GAODE_KEY=
AMAP_KEY=

# ---- 百度（可选；历史地点核验脚本用）----
# 申请：https://lbsyun.baidu.com/ → 控制台 → 应用管理 → 服务端 AK
BAIDU_SERVER_AK=

# ---- 天地图（可选；备用底图）----
TIANDITU_KEY=

# ---- AQICN/WAQI（可选；站点空气质量抓取，现用 CHAP 栅格，已不必需）----
# 申请：https://aqicn.org/data-platform/token/
AQICN_TOKEN=
